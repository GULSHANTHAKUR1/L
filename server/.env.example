PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/heterohms?retryWrites=true&w=majority

# Authentication & Cookies
JWT_SECRET=replace_with_a_secure_256_bit_secret_key_for_heterohms
JWT_EXPIRES_IN=8h
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_key

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI / OCR & Semantic Search Microservice Configuration (Prompts 13, 14, 15, 16)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=heterohms_internal_secret_key_2026
INTERNAL_CALLBACK_KEY=heterohms_callback_secret_key_2026

