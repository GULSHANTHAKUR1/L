# HETEROHMS AI & OCR Microservice Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Shared internal security key required in X-Internal-API-Key header
INTERNAL_API_KEY=heterohms_internal_secret_key_2026

# Callback URL for sending OCR results asynchronously back to Node.js backend
NODE_BACKEND_CALLBACK_URL=http://localhost:5000/api/v1/internal/ocr-callback
INTERNAL_CALLBACK_KEY=heterohms_callback_secret_key_2026

# File download safety constraints
MAX_FILE_SIZE_MB=10
DOWNLOAD_TIMEOUT_SECONDS=30

# Path to Tesseract binary (leave empty if tesseract is in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / Docker: /usr/bin/tesseract
TESSERACT_CMD=
